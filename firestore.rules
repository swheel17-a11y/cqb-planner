rules_version = '2';
// CQB planner: each scenario is one document in "scenarios".
// Anyone with a link (the document id) can open it. Only the signed-in owner can list, change or delete theirs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scenarios/{id} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.data is string && request.resource.data.data.size() < 900000
        && request.resource.data.title is string && request.resource.data.title.size() <= 120;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.data is string && request.resource.data.data.size() < 900000
        && request.resource.data.title is string && request.resource.data.title.size() <= 120;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
